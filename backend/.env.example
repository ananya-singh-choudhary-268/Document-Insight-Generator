# Required
OPENAI_API_KEY=your-openai-api-key-here

# Set this to your deployed frontend URL to enable credentialed CORS requests
# e.g. https://your-app.vercel.app  or  https://your-app.netlify.app
# Leave blank during local development (wildcard CORS is used instead)
FRONTEND_URL=

# Optional — defaults shown
OPENAI_MODEL=gpt-4o-mini
UPLOAD_DIR=./uploads
FAISS_INDEX_DIR=./faiss_index
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TESSERACT_LANG=eng
